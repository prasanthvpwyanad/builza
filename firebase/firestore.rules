rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function companyPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function joinPath(code) {
      return /databases/$(database)/documents/joinCodes/$(code);
    }

    function isCompanyAdmin(companyId) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.companyId == companyId
        && request.auth.uid in get(companyPath(companyId)).data.adminUids;
    }

    function validAdminProfile() {
      return request.resource.data.role == 'admin'
        && request.resource.data.adminSlot in [1, 2]
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.createdAt is timestamp;
    }

    function creatingFirstAdmin() {
      let companyId = request.resource.data.companyId;
      return request.resource.data.adminSlot == 1
        && !(request.resource.data.keys().hasAny(['joinCode']))
        && existsAfter(companyPath(companyId))
        && getAfter(companyPath(companyId)).data.createdBy == request.auth.uid
        && getAfter(companyPath(companyId)).data.adminUids == [request.auth.uid]
        && getAfter(companyPath(companyId)).data.adminCount == 1;
    }

    function creatingSecondAdmin() {
      let companyId = request.resource.data.companyId;
      let code = request.resource.data.joinCode;
      return request.resource.data.adminSlot == 2
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.matches('^[A-Z0-9]{8}$')
        && existsAfter(joinPath(code))
        && getAfter(joinPath(code)).data.used == true
        && getAfter(joinPath(code)).data.usedBy == request.auth.uid
        && getAfter(joinPath(code)).data.companyId == companyId
        && existsAfter(companyPath(companyId))
        && request.auth.uid in getAfter(companyPath(companyId)).data.adminUids
        && getAfter(companyPath(companyId)).data.adminCount == 2;
    }

    function joiningAsSecondAdmin(companyId) {
      return signedIn()
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.companyId == companyId
        && getAfter(userPath(request.auth.uid)).data.adminSlot == 2
        && !(request.auth.uid in resource.data.adminUids)
        && request.auth.uid in request.resource.data.adminUids
        && resource.data.adminCount == 1
        && request.resource.data.adminCount == 2
        && request.resource.data.adminUids.size() == 2
        && request.resource.data.adminUids.hasAll(resource.data.adminUids)
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.status == resource.data.status
        && request.resource.data.get('logoUrl', '') == resource.data.get('logoUrl', '')
        && request.resource.data.get('hasLogo', false) == resource.data.get('hasLogo', false);
    }

    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid
        || (
          exists(userPath(request.auth.uid))
          && resource.data.companyId == get(userPath(request.auth.uid)).data.companyId
        )
      );

      allow list: if signedIn()
        && exists(userPath(request.auth.uid))
        && resource.data.companyId == get(userPath(request.auth.uid)).data.companyId;

      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(userPath(uid))
        && validAdminProfile()
        && request.resource.data.keys().hasOnly([
          'companyId', 'email', 'displayName', 'role', 'adminSlot', 'createdAt', 'joinCode'
        ])
        && (creatingFirstAdmin() || creatingSecondAdmin());

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.role == resource.data.role
        && request.resource.data.adminSlot == resource.data.adminSlot;

      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if isCompanyAdmin(companyId);

      allow create: if signedIn()
        && !exists(userPath(request.auth.uid))
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.companyId == companyId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.adminUids == [request.auth.uid]
        && request.resource.data.adminCount == 1
        && request.resource.data.status == 'active'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt is timestamp;

      allow update: if (
          isCompanyAdmin(companyId)
          && request.resource.data.adminUids == resource.data.adminUids
          && request.resource.data.adminCount == resource.data.adminCount
          && request.resource.data.createdBy == resource.data.createdBy
        )
        || joiningAsSecondAdmin(companyId);

      allow delete: if false;

      match /{document=**} {
        allow read, write: if isCompanyAdmin(companyId);
      }
    }

    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.used == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && isCompanyAdmin(request.resource.data.companyId)
        && get(companyPath(request.resource.data.companyId)).data.adminCount < 2;

      allow update: if signedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']);

      allow delete: if signedIn()
        && isCompanyAdmin(resource.data.companyId);
    }
  }
}
